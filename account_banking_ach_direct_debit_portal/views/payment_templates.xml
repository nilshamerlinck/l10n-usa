<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_scheduled_payments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="account_banking_ach_direct_debit_portal.debit_portal_searchbar">
                <t t-set="title">Schedule Payments</t>
            </t>

            <t t-if="not payments">
                <p>There are currently no schedule payments for your account.</p>
            </t>
            <t t-if="payments" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Linked invoices</th>
                        <th>Schedule Date</th>
                        <th>Bank account</th>
                        <th class="text-center">Amount</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="payments" t-as="payment">
                        <tr>
                            <td>
                                #<span t-field="payment.move_id.id" />
                            </td>
                            <td><span t-field="payment.date" /></td>
                            <td><span
                                    t-field="payment.bank_partner_id.display_name"
                                /></td>
                            <td class="text-center"><span
                                    t-field="payment.amount_total"
                                /></td>
                            <td>
                                <div class="dropdown-wrapper text-center">
                                    <button
                                        class="btn border-0"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                    >
                                      ⋮
                                    </button>
                                    <ul
                                        class="dropdown-menu dropdown-menu-end shadow-sm rounded-3"
                                    >
                                        <li>
                                        <a class="dropdown-item" href="#"><i
                                                    class="fa fa-edit me-2"
                                                />Edit</a>
                                        </li>
                                        <li>
                                        <a class="dropdown-item" href="#"><i
                                                    class="fa fa-times me-2"
                                                /> Cancel</a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_payment">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="account_banking_ach_direct_debit_portal.debit_portal_searchbar">
                <t t-set="title">Payment</t>
            </t>

            <div id="payment" class="container my-4">
                <div class="row">
                  <div class="col-md-8 mb-3">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title">Details</h5>
                        </div>

                        <div class="table-responsive border-0">
                            <table class="table mb-0 bg-white o_portal_my_doc_table">
                                <thead class="thead-light">
                                    <tr>
                                      <th>Invoice no</th>
                                      <th>Date</th>
                                      <th>Due Date</th>
                                      <th>Amount</th>
                                      <th>Status</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <tr>
                                      <td>#100000</td>
                                      <td>08-04-25</td>
                                      <td>08-04-25</td>
                                      <td>$50</td>
                                      <td><span
                                                    class="badge text-bg-info"
                                                >Due</span></td>
                                    </tr>
                                    <tr>
                                      <td>#100000</td>
                                      <td>08-04-25</td>
                                      <td>08-04-25</td>
                                      <td>$50</td>
                                      <td><span
                                                    class="badge text-bg-info"
                                                >Due</span></td>
                                    </tr>
                                  </tbody>
                            </table>
                        </div>
                    </div>
                  </div>

                  <div class="col-md-4 mb-3">
                    <div class="card summary h-100">
                      <div class="card-body">
                        <h5 class="card-title">Summary</h5>
                        <div class="d-flex justify-content-between mb-2">
                          <span class="label">Quantity</span>
                          <span>2</span>
                        </div>
                        <div
                                    class="d-flex justify-content-between border-top pt-2 mb-2"
                                >
                          <span class="label">Total amount</span>
                          <span>$100</span>
                        </div>
                        <div
                                    class="d-flex justify-content-between border-top pt-2 mb-2"
                                >
                          <span class="label">Due date</span>
                          <span>08-04-25</span>
                        </div>
                        <div
                                    class="d-flex justify-content-between fw-bold border-top pt-2 mt-2"
                                >
                          <span class="label">Total amount</span>
                          <span>$100</span>
                        </div>
                        <a
                                    href="/select-payment-method"
                                    class="btn btn-submit w-100 mt-5"
                                >Make a Payment</a>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_manual_payment">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="account_banking_ach_direct_debit_portal.debit_portal_searchbar">
                <t t-set="title">Manual Payment</t>
            </t>

            <div id="payment" class="container my-4">
                <div class="row">
                  <div class="col-md-8 mb-3">
                    <div class="card h-100">
                        <div class="card-header">
                            <div
                                    class="d-flex justify-content-between align-items-center underline"
                                >
                                <h5 class="card-title">Invoice</h5>

                                <select class="invoice-select">
                                    <option selected="true">Select an invoice</option>
                                    <option value="1">0000121</option>
                                    <option value="2">0000122</option>
                                    <option value="3">0000123</option>
                                </select>

                            </div>
                        </div>

                        <div class="table-responsive border-0">
                            <table class="table mb-0 bg-white o_portal_my_doc_table">
                                <thead class="thead-light">
                                    <tr>
                                      <th>Invoice no</th>
                                      <th>Date</th>
                                      <th>Due Date</th>
                                      <th>Amount</th>
                                      <th>Status</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <tr>
                                      <td>#100000</td>
                                      <td>08-04-25</td>
                                      <td>08-04-25</td>
                                      <td>$50</td>
                                      <td><span
                                                    class="badge text-bg-info"
                                                >Due</span></td>
                                    </tr>
                                    <tr>
                                      <td>#100000</td>
                                      <td>08-04-25</td>
                                      <td>08-04-25</td>
                                      <td>$50</td>
                                      <td><span
                                                    class="badge text-bg-info"
                                                >Due</span></td>
                                    </tr>
                                  </tbody>
                            </table>
                        </div>
                    </div>
                  </div>

                  <div class="col-md-4 mb-3">
                    <div class="card summary h-100">
                      <div class="card-body">
                        <h5 class="card-title">Details</h5>
                        <div class="d-flex justify-content-between mb-2">
                          <span class="label">Invoice no</span>
                          <span />
                        </div>
                        <div
                                    class="d-flex justify-content-between border-top pt-2 mb-2"
                                >
                          <span class="label">Amount due</span>
                          <span>$50</span>
                        </div>
                        <div
                                    class="d-flex justify-content-between border-top pt-2 mb-2"
                                >
                          <span class="label">Due date</span>
                          <span>08-04-25</span>
                        </div>
                        <a
                                    href="/select-payment-method"
                                    class="btn btn-submit w-100 mt-5"
                                >Make a Payment</a>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_select_payment_method">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="account_banking_ach_direct_debit_portal.debit_portal_searchbar">
                <t t-set="title">Select Payment Method</t>
            </t>

            <div id="payment" class="container my-4">
                <div class="row">
                  <div class="col-md-8 mb-3">
                    <h5 class="card-title">Payment method</h5>

                    <div class="rounded border mt-3">
                        <label class="payment-method-option" for="rule_1">
                            <div
                                    class="d-flex justify-content-between align-items-center cursor-pointer w-100"
                                >
                                <div
                                        class="d-flex justify-content-start align-items-center"
                                    >
                                    <input
                                            type="radio"
                                            name="autopay_rule"
                                            id="rule_1"
                                            checked="true"
                                        />
                                    <span class="option ms-2">Bank account</span>
                                    <span
                                            class="note text-muted ms-2"
                                        >1% Discount (with plaid verification)</span>
                                </div>

                                <div />
                            </div>
                        </label>

                        <label class="payment-method-option" for="rule_2">
                            <div
                                    class="d-flex justify-content-between align-items-center cursor-pointer w-100"
                                >
                                <div
                                        class="d-flex justify-content-start align-items-center"
                                    >
                                    <input
                                            type="radio"
                                            name="autopay_rule"
                                            id="rule_2"
                                        />
                                    <span class="option ms-2">Credit card</span>
                                    <span
                                            class="note text-muted ms-2"
                                        >3% Surcharge</span>
                                </div>

                                <div><img
                                            t-att-src="'/account_banking_ach_direct_debit_portal/static/src/img/credit_card.png'"
                                            alt="My Image"
                                            class="credit_card_img"
                                        /></div>
                            </div>
                        </label>
                    </div>
                  </div>

                  <div class="col-md-4 mb-3">
                    <div class="card summary h-100">
                      <div class="card-body">
                        <h5 class="card-title">Details</h5>
                        <div class="d-flex justify-content-between mb-2">
                          <span class="label">Invoice no</span>
                          <span />
                        </div>
                        <div
                                    class="d-flex justify-content-between border-top pt-2 mb-2"
                                >
                          <span class="label">Amount due</span>
                          <span>$50</span>
                        </div>
                        <div
                                    class="d-flex justify-content-between border-top pt-2 mb-2"
                                >
                          <span class="label">Due date</span>
                          <span>08-04-25</span>
                        </div>
                        <button
                                    class="btn btn-submit w-100 mt-5"
                                >Make a Payment</button>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
