<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_banks">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="account_banking_ach_direct_debit_portal.debit_portal_searchbar">
                <t t-set="title">My Banks</t>
            </t>

            <div id="bank_accounts">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <h3 class="header-title mb-0">Bank Accounts</h3>

                    <a href="/my/add-bank" class="btn btn-blue">
                        Add new
                    </a>
                </div>

                <t t-if="not bank_accounts">
                    <p>There are currently no bank accounts for your account.</p>
                </t>
                <t t-if="bank_accounts">
                    <t t-foreach="bank_accounts" t-as="bank">
                        <div
                            class="bank-account d-flex justify-content-between align-items-center mt-3"
                        >
                            <div class="bank-info">
                                <div><t t-esc="bank.acc_holder_name" /></div>
                                <div><t t-esc="bank.bank_name" /></div>
                                <div><t t-esc="bank.acc_number" /></div>
                            </div>

                            <div
                                class="d-flex justify-content-end align-items-center mt-3"
                            >
                                <a
                                    t-att-href="'/my/bank/edit/%s' % bank.id"
                                    class="edit-btn cursor-pointer me-4"
                                >
                                    <i class="fa fa-pencil me-1" /> Edit
                                </a>

                                <a
                                    t-att-href="'/my/bank/delete/%s' % bank.id"
                                    class="edit-btn cursor-pointer"
                                >
                                    <i class="fa fa-trash me-1" /> Delete
                                </a>
                            </div>
                        </div>
                    </t>
                </t>

                <div class="d-flex justify-content-end align-items-center w-100 mt-10">
                    <a href="javascript:history.back()" class="btn btn-back">
                        <i class="fa fa-angle-left me-2" /> Back
                    </a>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_bank_form">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="account_banking_ach_direct_debit_portal.debit_portal_searchbar">
                <t t-set="title">Add bank account</t>
            </t>

            <div id="bank_accounts">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <h3 class="title mb-0">Bank details</h3>
                </div>

                <form
                    class="mt-3"
                    method="post"
                    t-att-action="edit_mode and ('/my/bank/edit/%s' % bank.id) or '/my/add-bank'"
                >
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />
                    <div class="form-grid">
                      <div>
                        <label>Account Holder Name</label>
                        <input
                                type="text"
                                name="acc_holder_name"
                                t-att-value="edit_mode and bank.acc_holder_name or ''"
                            />
                      </div>
                      <div>
                        <label>Account Type</label>
                        <select name="acc_type">
                            <t t-foreach="acc_type_choices" t-as="choice">
                                <option
                                        t-att-value="choice[0]"
                                        t-att-selected="'selected' if edit_mode and choice[0] == bank.acc_type else None"
                                    >
                                  <t t-esc="choice[1]" />
                                </option>
                              </t>
                        </select>
                      </div>

                      <div>
                        <label>Routing Number</label>
                        <input
                                type="text"
                                name="routing_number"
                                t-att-value="edit_mode and bank.aba_routing or ''"
                            />
                      </div>
                      <div>
                        <label>Account Number</label>
                        <input
                                type="text"
                                name="acc_number"
                                t-att-value="edit_mode and bank.acc_number or ''"
                            />
                      </div>

                      <div>
                        <label>Bank Name</label>
                        <input
                                type="text"
                                name="bank_name"
                                t-att-value="edit_mode and bank.bank_name or ''"
                            />
                      </div>
                      <div>
                        <label>Bank Address</label>
                        <input
                                type="text"
                                name="bank_address"
                                t-att-value="edit_mode and bank.bank_address or ''"
                            />
                      </div>
                    </div>

                    <div
                        class="d-flex justify-content-end align-items-center w-100 mt-3"
                    >
                        <a href="javascript:history.back()" class="btn btn-back me-2">
                            Discard
                        </a>

                        <button class="btn btn-blue">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>
