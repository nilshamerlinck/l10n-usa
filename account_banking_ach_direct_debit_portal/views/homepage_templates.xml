<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_my_home">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="account_banking_ach_direct_debit_portal.debit_portal_searchbar">
                <t t-set="title">HomePage</t>
            </t>

            <div id="account-homepage">
                <div class="d-flex justify-content-start align-items-center mb-4">
                    <h2 class="header-title me-2">My Account</h2>
                    <a
                        href="/autopay-rules"
                        class="btn btn-blue me-2"
                    >Auto Pay Settings</a>
                    <a
                        href="/manual-payment"
                        class="btn btn-secondary"
                    >Make a Payment</a>
                </div>

                <div class="row g-4">
                    <div class="col-md-4">
                      <div class="card-credit">
                        <div
                                class="d-flex justify-content-between align-items-center mb-2"
                            >
                            <i class="icon fa fa-credit-card" />

                            <div class="info-icon">
                                <i class="fa fa-info" />
                            </div>
                        </div>
                        <h6>Total credit limit</h6>
                        <div class="amount">$350.00</div>
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="card-credit">
                        <div
                                class="d-flex justify-content-between align-items-center mb-2"
                            >
                            <i class="icon fa fa-credit-card" />
                            <div class="info-icon">
                                <i class="fa fa-info" />
                            </div>
                        </div>
                        <h6>Available credit</h6>
                        <div class="amount">$120.00</div>
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="card-credit">
                        <div
                                class="d-flex justify-content-between align-items-center mb-2"
                            >
                            <i class="icon fa fa-credit-card" />
                            <div class="info-icon">
                                <i class="fa fa-info" />
                            </div>
                        </div>
                        <h6>Amount due</h6>
                        <div class="amount">$240.00</div>
                      </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5">
                    <h4>Invoices</h4>

                    <div class="d-flex justify-content-start align-items-center">
                        <div t-if="invoice_searchbar_sortings" class="me-2">
                            <span class="small me-1 navbar-text">Sort By:</span>
                            <div class="btn-group">
                                <button
                                    id="portal_searchbar_sortby"
                                    data-bs-toggle="dropdown"
                                    class="btn btn-secondary dropdown-toggle"
                                >
                                    <t
                                        t-esc="invoice_searchbar_sortings[invoice_sortby].get('label', 'Lastest')"
                                    />
                                </button>
                                <div
                                    class="dropdown-menu"
                                    aria-labelledby="portal_searchbar_sortby"
                                >
                                    <t
                                        t-foreach="invoice_searchbar_sortings"
                                        t-as="option"
                                    >
                                        <a
                                            t-att-href="request.httprequest.path + '?' + keep_query('*', invoice_sortby=option)"
                                            t-attf-class="dropdown-item#{invoice_sortby == option and ' active' or ''}"
                                        >
                                            <span
                                                t-esc="invoice_searchbar_sortings[option].get('label')"
                                            />
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <a href="/my/invoices" class="btn btn-blue">View all</a>
                    </div>
                </div>

                <div class="table-responsive border-0 mt-2">
                    <table class="table mb-0 bg-white o_portal_my_doc_table">
                        <thead class="thead-light">
                            <tr>
                                <th>Invoice no</th>
                                <th>Date</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            <t t-foreach="invoices" t-as="invoice">
                                <tr>
                                    <td>#<span t-field="invoice.id" /></td>
                                    <td><span t-field="invoice.invoice_date" /></td>
                                    <td><span t-field="invoice.invoice_date_due" /></td>
                                    <td><span
                                            t-esc="-invoice.amount_residual if invoice.move_type == 'out_refund' else invoice.amount_residual"
                                            t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'
                                        /></td>
                                    <td class="tx_status">
                                        <t
                                            t-if="invoice.state == 'posted' and invoice.payment_state not in ('in_payment', 'paid', 'reversed')"
                                        >
                                            <span
                                                class="badge rounded-pill text-bg-info"
                                            ><i
                                                    class="fa fa-fw fa-clock-o"
                                                    aria-label="Opened"
                                                    title="Opened"
                                                    role="img"
                                                /><span
                                                    class="d-none d-md-inline"
                                                > Waiting for Payment</span></span>
                                        </t>
                                        <t
                                            t-if="invoice.state == 'posted' and invoice.payment_state in ('paid', 'in_payment')"
                                        >
                                            <span
                                                class="badge rounded-pill text-bg-success"
                                            ><i
                                                    class="fa fa-fw fa-check"
                                                    aria-label="Paid"
                                                    title="Paid"
                                                    role="img"
                                                /><span
                                                    class="d-none d-md-inline"
                                                > Paid</span></span>
                                        </t>
                                        <t
                                            t-if="invoice.state == 'posted' and invoice.payment_state == 'reversed'"
                                        >
                                            <span
                                                class="badge rounded-pill text-bg-success"
                                            ><i
                                                    class="fa fa-fw fa-check"
                                                    aria-label="Reversed"
                                                    title="Reversed"
                                                    role="img"
                                                /><span
                                                    class="d-none d-md-inline"
                                                > Reversed</span></span>
                                        </t>
                                        <t t-if="invoice.state == 'cancel'">
                                            <span
                                                class="badge rounded-pill text-bg-warning"
                                            ><i
                                                    class="fa fa-fw fa-remove"
                                                    aria-label="Cancelled"
                                                    title="Cancelled"
                                                    role="img"
                                                /><span
                                                    class="d-none d-md-inline"
                                                > Cancelled</span></span>
                                        </t>
                                    </td>
                                    <td>
                                        <a
                                            t-att-href="invoice.get_portal_url()"
                                            t-att-title="invoice.name"
                                            class="btn btn-secondary rounded-pill px-3"
                                        >
                                        View Invoice
                                    </a>
                                    </td>
                                </tr>
                            </t>
                          </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5">
                    <h4>Payment history</h4>

                    <div class="d-flex justify-content-start align-items-center">
                        <div t-if="payment_searchbar_sortings" class="me-2">
                            <span class="small me-1 navbar-text">Sort By:</span>
                            <div class="btn-group">
                                <button
                                    id="portal_searchbar_sortby"
                                    data-bs-toggle="dropdown"
                                    class="btn btn-secondary dropdown-toggle"
                                >
                                    <t
                                        t-esc="payment_searchbar_sortings[payment_sortby].get('label', 'Lastest')"
                                    />
                                </button>
                                <div
                                    class="dropdown-menu"
                                    aria-labelledby="portal_searchbar_sortby"
                                >
                                    <t
                                        t-foreach="payment_searchbar_sortings"
                                        t-as="option"
                                    >
                                        <a
                                            t-att-href="request.httprequest.path + '?' + keep_query('*', payment_sortby=option)"
                                            t-attf-class="dropdown-item#{payment_sortby == option and ' active' or ''}"
                                        >
                                            <span
                                                t-esc="payment_searchbar_sortings[option].get('label')"
                                            />
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <a href="/my/payments" class="btn btn-blue">View all</a>
                    </div>
                </div>

                <div class="table-responsive border-0 mt-2">
                    <table class="table mb-0 bg-white o_portal_my_doc_table">
                        <thead class="thead-light">
                            <tr>
                                <th>Invoice no</th>
                                <th>Date</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            <t t-foreach="payments" t-as="payment">
                                <tr>
                                    <td>#<span t-field="payment.id" /></td>
                                    <td><span t-field="payment.date" /></td>
                                    <td><span t-field="payment.invoice_date_due" /></td>
                                    <td><span t-field="payment.amount_total" /></td>
                                    <td><span t-field="payment.payment_state" /></td>
                                    <td>
                                        <a class="btn btn-secondary rounded-pill px-3">
                                        View Payment
                                    </a>
                                    </td>
                                </tr>
                            </t>
                          </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
