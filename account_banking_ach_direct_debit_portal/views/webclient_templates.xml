<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="frontend_layout"
        name="Main Frontend Layout"
        inherit_id="portal.frontend_layout"
    >
        <xpath expr="//a[contains(@class, 'navbar-brand')]" position="after">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div class="d-flex justify-content-start">
                    <a href="#" class="nav-item me-3">Home</a>
                    <a href="#" class="nav-item me-4">Products</a>
                    <a href="#" class="nav-item me-3">My Account</a>
                    <a href="#" class="nav-item me-3">Articles</a>
                    <a href="#" class="nav-item me-3">Contact</a>
                    <a href="#" class="nav-item me-3">Blog</a>
                    <a href="#" class="nav-item me-3">Events</a>
                    <a href="#" class="nav-item me-3">Jobs</a>
                </div>

                <div class="d-flex justify-content-end">
                    <div class="dropdown-wrapper position-relative text-center">
                        <div
                            data-bs-toggle="dropdown"
                            class="circle-icon cursor-pointer me-2"
                        >
                            <i class="fa fa-bell" />
                        </div>

                        <div
                            class="notification-box pt-3 pb-0 dropdown-menu dropdown-menu-end shadow-sm rounded-3"
                        >
                            <h6 class="fw-semibold px-3 mb-2">Notifications</h6>

                            <div class="notification-item d-flex px-3 py-2">
                                <span class="notification-icon">✅</span>
                                <span><strong
                                    >Bank Verified</strong> — Your bank account has been successfully verified.</span>
                            </div>

                            <div class="notification-item d-flex px-3 py-2">
                                <span class="notification-icon">🏦</span>
                                <span><strong
                                    >Bank Saved</strong> — Your bank account has been successfully saved to the portal.</span>
                            </div>

                            <div class="notification-item d-flex px-3 pt-2">
                                <span class="notification-icon">🏠</span>
                                <span><strong
                                    >Bank Account Added</strong> — Your bank information has been securely saved.</span>
                            </div>
                        </div>
                    </div>

                    <div class="circle-icon cursor-pointer me-2">
                        <i class="fa fa-shopping-cart" />
                    </div>

                    <div class="circle-icon cursor-pointer me-2">
                        <i class="fa fa-search" />
                    </div>
                </div>
            </div>
          </xpath>
    </template>
</odoo>
